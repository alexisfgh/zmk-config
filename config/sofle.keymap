#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {

   // Activate ADJUST layer by pressing raise and lower
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮                               ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
// |     ESC     |      1      |      2      |      3      |      4      |      5      |                               |      6      |      7      |      8      |      9      |      0      |     BSPC    |
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤                               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
// |     TAB     |      Q      |      W      |      E      |      R      |      T      |                               |      Y      |      U      |      I      |      O      |      P      |      [      |
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤                               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
// |     CAPS    |      A      |      S      |      D      |      F      |      G      |                               |      H      |      J      |      K      |      L      |      ;      |      '      |
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────╮    ╭────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
// |     LSHIFT  |      Z      |      X      |      C      |      V      |      B      |     MUTE    |    |     RGB    |      N      |      M      |      ,      |      .      |      /      |      ]      |
// ╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼─────────────├─────────────┤    ├────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
//                             |     LCTRL   |     LALT    |     LGUI    |     LOWER   |    ENTER    |    |   SPACE    |    RAISE    |     GLOBE   |     RALT    |      \      |
//                             ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯    ╰────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
                        bindings = <
            &kp ESC   &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                                  &kp N6     &kp N7    &kp N8    &kp N9   &kp N0   &kp BSPC
            &kp TAB   &kp Q  &kp W    &kp E    &kp R     &kp T                                   &kp Y      &kp U     &kp I     &kp O    &kp P    &kp LBKT
            &kp CLCK  &kp A  &kp S    &kp D    &kp F     &kp G                                   &kp H      &kp J     &kp K     &kp L    &kp SEMI &kp SQT
            &kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B      &kp C_MUTE &rgb_ug RGB_TOG   &kp N      &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RBKT
                          &kp LCTRL &kp LALT &kp LGUI  &mo LOWER  &kp RET    &kp SPACE         &mo RAISE  &kp RALT   &kp GLOBE    &kp BSLH
                        >; 

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "lower";
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮                               ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
// |    ` ~      |      F1     |      F2     |     F3      |      F4     |      F5     |                               |      F6     |      F7     |      F8     |      F9     |      F10    |     DEL     |
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤                               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
// |             |             |      (      |      )      |      [      |      ]      |                               |      +      |      7      |      8      |      9      |      F11    |             |
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤                               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
// |             |             |      &      |      |      |      {      |      }      |                               |      -      |      4      |      5      |      6      |      F12    |             |
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────╮    ╭────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
// |             |             |      /      |      \      |      <      |      >      |             |    |            |      _      |      1      |      2      |      3      |      \      |             |
// ╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼─────────────├─────────────┤    ├────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
//                             |             |             |             |             |             |    |     =      |             |             |      0      |             |
//                             ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯    ╰────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
                        bindings = <
            &kp GRAVE &kp F1    &kp F2    &kp F3    &kp F4    &kp F5                     &kp F6    &kp F7       &kp F8       &kp F9       &kp F10    &kp DEL
            &none    &none    &kp LPAR  &kp RPAR  &kp LBKT  &kp RBKT                   &kp PLUS  &kp KP_N7    &kp KP_N8    &kp KP_N9    &kp F11    &none 
            &none    &none    &kp AMPS  &kp PIPE  &kp LBRC  &kp RBRC                   &kp MINUS &kp KP_N4    &kp KP_N5    &kp KP_N6    &kp F12    &none
            &none    &none    &kp FSLH  &kp BSLH  &kp LT    &kp GT    &trans &trans    &kp UNDER &kp KP_N1    &kp KP_N2    &kp KP_N3    &kp BSLH   &none
                                &trans    &trans    &trans    &trans    &trans &kp EQUAL &trans    &trans    &kp KP_N0    &trans
                        >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "raise";
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮                               ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
// |    BTCLR    |     BT1     |     BT2     |     BT3     |     BT4     |     BT5     |                               |   PREVIEW   |     PLAY    |     NEXT    |     MUTE    |   VOL DOWN  |   VOL UP    |
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤                               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
// |             |             |             |             |      !      |      @      |                               |             |             |      ^      |             |             |             |
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤                               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
// |             |             |             |             |      #      |      $      |                               |             |      <-     |      v      |     ->      |             |             |
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────╮    ╭────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
// |    LSHIFT   |             |             |             |      %      |      *      |   RGB_EFF   |    |            |             |             |             |             |             |   RSHIFT    |
// ╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼─────────────├─────────────┤    ├────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
//                             |             |             |             |             |             |    |            |             |             |             |             |
//                             ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯    ╰────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
                        bindings = <
            &none     &none       &none       &none       &none       &none                                  &kp C_PREV &kp C_PP   &kp C_NEXT  &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP
            &none     &none       &kp UP       &none       &kp EXCL     &kp AT                               &none     &none     &kp UP      &none        &none        &none
            &none     &kp LEFT     &kp DOWN     &kp RIGHT    &kp HASH     &kp DLLR                           &none     &kp LEFT   &kp DOWN    &kp RIGHT     &none        &none
            &kp LSHFT &none       &none       &none       &kp PRCNT    &kp ASTRK   &rgb_ug RGB_EFF   &trans  &none     &none     &none      &none        &none        &kp LRSHFT
                                    &trans       &trans       &trans       &trans      &trans            &trans  &trans     &trans     &trans      &trans  
                        >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮                               ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
// |    BTCLR    |     BT1     |     BT2     |     BT3     |     BT4     |     BT5     |                               |             |             |             |             |             |             |
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤                               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
// |    EXTPWR   |   RGB_HUD   |   RGB_HUI   |   RGB_SAD   |   RGB_SAI   |   RGB_EFF   |                               |             |             |             |             |             |             |
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤                               ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
// |             |   RGB_BRD   |   RGB_BRI   |             |             |             |                               |             |             |             |             |             |             |
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┬─────────────╮    ╭────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
// |             |   RGB_SPD   |   RGB_SPI   |             |             |             |   RGB_TOG   |    |            |             |             |             |             |             |             |
// ╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼─────────────├─────────────┤    ├────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
//                             |             |             |             |             |             |    |            |             |             |             |             |
//                             ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯    ╰────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
                display-name = "adjust";
                bindings = <
            &bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                                   &none &none &none &none &none &none
            &ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                                &none &none &none &none &none &none
            &none             &rgb_ug RGB_BRD &rgb_ug RGB_BRI &none           &none           &none                                          &none &none &none &none &none &none
            &none             &rgb_ug RGB_SPD &rgb_ug RGB_SPI &none           &none           &none    &rgb_ug RGB_TOG          &none  &none &none &none &none &none &none
                                            &none           &none           &none           &none    &none                    &none  &none &none &none &none
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };

        extra4 { status = "reserved"; };
    };
};
